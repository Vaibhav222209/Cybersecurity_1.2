  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "engines": {
    "node": ">=22.12.0"
  }
